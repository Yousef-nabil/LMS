generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model announcements {
  id            BigInt   @id @default(autoincrement())
  course_id     BigInt
  instructor_id BigInt
  message       String
  posted_at     DateTime @default(now()) @db.Timestamp(6)
  courses       courses  @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users    @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model assignments {
  id                BigInt          @id @default(autoincrement())
  course_id         BigInt
  title             String          @db.VarChar(255)
  type              assignment_type
  max_score         Decimal         @db.Decimal(10, 2)
  questions_answers Json
  courses           courses         @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submissions       submissions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model choices {
  id              Int               @id @default(autoincrement())
  question_id     Int
  choice_text     String?
  is_correct      Boolean?          @default(false)
  questions       questions         @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_choice_question")
  student_answers student_answers[]
}

model contents {
  id            BigInt       @id @default(autoincrement())
  course_id     BigInt
  title         String       @db.VarChar(255)
  type          content_type
  file_url      String?      @db.VarChar(500)
  file_size     BigInt?
  position      String?      @db.VarChar(50)
  thumbnail_url String?
  courses       courses      @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model courses {
  id            BigInt          @id @default(autoincrement())
  instructor_id BigInt
  title         String          @db.VarChar(255)
  description   String?
  price         Decimal?        @db.Decimal(10, 2)
  created_at    DateTime        @default(now()) @db.Timestamp(6)
  thumbnail_url String?
  is_published  Boolean?        @default(false)
  announcements announcements[]
  assignments   assignments[]
  contents      contents[]
  users         users           @relation(fields: [instructor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrollments   enrollments[]
  payments      payments[]
  quizzes       quizzes[]
}

model enrollments {
  id              BigInt    @id @default(autoincrement())
  student_id      BigInt
  course_id       BigInt
  payment_id      BigInt?
  enrollment_date DateTime  @default(now()) @db.Timestamp(6)
  courses         courses   @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments        payments? @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users     @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, course_id])
}

model payments {
  id               BigInt         @id @default(autoincrement())
  student_id       BigInt
  course_id        BigInt
  stripe_token     String?        @db.VarChar(255)
  amount           Decimal        @db.Decimal(10, 2)
  status           payment_status @default(pending)
  transaction_date DateTime       @default(now()) @db.Timestamp(6)
  enrollments      enrollments[]
  courses          courses        @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users          @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id              Int               @id @default(autoincrement())
  quiz_id         Int
  question_text   String?
  marks           Int?              @default(1)
  order_index     Int?
  choices         choices[]
  quizzes         quizzes           @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_question_quiz")
  student_answers student_answers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model quiz_attempts {
  id              Int               @id @default(autoincrement())
  quiz_id         Int
  student_id      BigInt
  score           Int?              @default(0)
  started_at      DateTime?         @db.Timestamp(6)
  submitted_at    DateTime?         @db.Timestamp(6)
  quizzes         quizzes           @relation(fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_quiz")
  users           users             @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attempt_student")
  student_answers student_answers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model quizzes {
  id            Int             @id @default(autoincrement())
  course_id     BigInt
  title         String?         @db.VarChar(255)
  description   String?
  time_limit    Int?
  due_date      DateTime?       @db.Timestamp(6)
  total_marks   Int?            @default(0)
  status        quiz_status?    @default(draft)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  questions     questions[]
  quiz_attempts quiz_attempts[]
  courses       courses         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_course")
}

model refresh_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  token      String    @unique
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  revoked    Boolean?  @default(false)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_answers {
  id                 Int           @id @default(autoincrement())
  attempt_id         Int
  question_id        Int
  selected_choice_id Int
  is_correct         Boolean?
  quiz_attempts      quiz_attempts @relation(fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_attempt")
  choices            choices       @relation(fields: [selected_choice_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_choice")
  questions          questions     @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_answer_question")
}

model submissions {
  id                BigInt      @id @default(autoincrement())
  assignment_id     BigInt
  student_id        BigInt
  auto_graded_score Decimal?    @db.Decimal(10, 2)
  submission_date   DateTime    @default(now()) @db.Timestamp(6)
  assignments       assignments @relation(fields: [assignment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users       @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([assignment_id, student_id])
}

model users {
  id                  BigInt           @id @default(autoincrement())
  name                String           @db.VarChar(255)
  email               String           @unique @db.VarChar(255)
  password_hash       String           @db.VarChar(255)
  role                user_role
  google_sub          String?
  profile_picture_url String?
  announcements       announcements[]
  courses             courses[]
  enrollments         enrollments[]
  payments            payments[]
  quiz_attempts       quiz_attempts[]
  refresh_tokens      refresh_tokens[]
  submissions         submissions[]
}

enum assignment_type {
  mcq
  true_false
}

enum content_type {
  video
  document
  quiz
  assignment
}

enum payment_status {
  pending
  completed
  failed
  refunded
}

enum quiz_status {
  draft
  published
  closed
}

enum user_role {
  instructor
  student
}
